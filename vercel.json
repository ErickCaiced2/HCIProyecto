{
  "version": 2,
  "buildCommand": "echo 'Static HTML project'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*).html",
      "destination": "/$1.html"
    }
  ]
}


